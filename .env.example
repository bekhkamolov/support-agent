# Copy this file to .env and fill in your keys. Never commit .env.
MISTRAL_API_KEY=

# Optional: Gemini as LLM judge (scripts/judge_agreement.py)
GEMINI_API_KEY=

# Optional: chat model used by the API (default ministral-14b-latest)
AGENT_MODEL=

# Optional: tracing to Langfuse (cloud.langfuse.com -> project settings -> API keys).
# Tracing is off unless both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com   (EU, default; US: https://us.cloud.langfuse.com)
# LANGFUSE_INCLUDE_CONTENT=false             (export only structure, timings and tokens, no message text)
